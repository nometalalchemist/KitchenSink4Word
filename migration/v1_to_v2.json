{
  "schema": 1,
  "v1_version": "1.6.0",
  "v2_version": "2.0.0",
  "_status": "COMPLETE (v2 Phase 2): one entry per shipped v1.6.0 tool, all 189, merged from the five wave fragments plus the Phase 0 batch_apply row. The completeness test in tests/unit/test_v2_migration_map.py is enforced.",
  "_entry_fields": {
    "to": "v2 tool name",
    "inject": "literal v2 param values that reproduce the v1 tool's fixed behavior",
    "params": "old param name -> new param path, dot notation into nested objects like the location object",
    "notes": "optional free text"
  },
