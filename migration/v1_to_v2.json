        "occurrence": "location.search.occurrence",
        "note_text": "text"
      }
    },
    "add_equation": {
      "to": "insert_equation",
      "params": {
        "after_index": "location.paragraph"
      },
      "notes": "display placement moves to the location object; inline placement (display=false) keeps anchor_text/occurrence unchanged"
    },
    "add_footnote": {
      "to": "manage_note",
      "inject": {
        "action": "insert",
        "note_type": "footnote"
      },
      "params": {
        "anchor_text": "location.search.text",
        "occurrence": "location.search.occurrence",
        "note_text": "text"
