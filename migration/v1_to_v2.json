      },
      "notes": "after_anchor -> location:{search:{text}}; at_end -> omit location"
    },
    "add_comment": {
      "to": "manage_comment",
      "inject": {
        "action": "add"
      },
      "params": {
        "anchor_text": "location.search.text",
        "occurrence": "location.search.occurrence",
        "text": "text",
        "author": "author"
      }
    },
    "add_cross_reference": {
      "to": "insert_cross_reference",
      "params": {
        "after_anchor": "location.search.text",
        "to_bookmark": "to_bookmark",
        "kind": "kind"
      },
      "notes": "renamed to the insert_ verb family; v1 had no occurrence param (acted on first match), the v2 search selector defaults occurrence=1"
    },
    "add_endnote": {
      "to": "manage_note",
      "inject": {
        "action": "insert",
        "note_type": "endnote"
