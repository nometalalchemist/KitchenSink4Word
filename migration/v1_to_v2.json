      "notes": "merged; heading_level maps to the Heading style, or to outlineLvl on outline-based documents (the NSU lesson); at_end=true -> omit location entirely (document-end default)."
    },
    "add_hyperlink": {
      "to": "insert_hyperlink",
      "params": {}
    },
    "add_image": {
